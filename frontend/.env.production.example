# Frontend Production Environment Configuration
# Copy this to frontend/.env.production and fill in your actual values
# NEVER commit this file to version control

# Environment
VITE_ENV=production
VITE_DEBUG=false

# API Configuration
# Use the internal Docker network hostname for container-to-container communication
VITE_API_URL=http://backend:4000
# Or if accessing from outside Docker network:
# VITE_API_URL=https://api.yourdomain.com

# Application
VITE_APP_NAME=GW Dashboard
VITE_APP_VERSION=1.0.0

# Analytics (if applicable)
# VITE_ANALYTICS_ID=google-analytics-id
# VITE_SENTRY_DSN=sentry-dsn-url

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=false

# Authentication
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_AUTH_REDIRECT_URL=/auth/callback

# Branding
VITE_THEME_COLOR=#1976d2
VITE_PRIMARY_BRAND_NAME=Your Organization

# Security
VITE_CSP_ENABLED=true

# Timeout configurations (milliseconds)
VITE_API_TIMEOUT=30000
VITE_SESSION_TIMEOUT=1800000

# Additional production variables
# Add your app-specific variables below
