# Backend Production Environment Configuration
# Copy this to backend/.env.production and fill in your actual values
# NEVER commit this file to version control

# Application
NODE_ENV=production
LOG_LEVEL=info
PORT=4000

# API Configuration
API_TIMEOUT=30000
API_MAX_REQUESTS=100
API_RATE_LIMIT_WINDOW_MS=900000

# Google Workspace Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URL=http://localhost/auth/callback

# CORS Configuration
CORS_ORIGIN=http://localhost
CORS_CREDENTIALS=true

# Logging
LOG_FORMAT=json
LOG_DIRECTORY=/app/logs

# Database (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gw_dashboard
# DB_USER=app_user
# DB_PASSWORD=secure-password-here

# Cache (if applicable)
# REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-here

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_DEBUG_ENDPOINTS=false

# External Services
# API_KEY_SERVICE=your-api-key-here
# WEBHOOK_URL=https://your-webhook-url

# Health Check
HEALTH_CHECK_ENABLED=true

# Additional production variables
# Add your service-specific variables below
